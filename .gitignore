# Vendored external tool binary -- fetched by scripts/setup.sh, not committed
tools/code-maat.jar

# Run output. This is a tool repo, not a data repo -- analyses/ is
# regenerated per-run by `cli.py analyze` against whatever target you point
# it at, and a real run also carries real secret-scanning output (secret
# fragments, CVE data) that has no business in a public tool repo. Keep
# example output out of git; ship it separately if you want to share one
# run's findings.
analyses/
_tmp/

